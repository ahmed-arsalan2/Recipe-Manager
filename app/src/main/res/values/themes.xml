<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.Recipe" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Colors -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/primary_ink</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- System UI -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Default text -->
        <item name="android:textColorPrimary">@color/primary_ink</item>
        <item name="android:textColorSecondary">@color/secondary_ink</item>

    </style>

    <style name="Theme.Recipe" parent="Base.Theme.Recipe" />

    <!-- ===================== Typography ===================== -->

    <style name="RecipeTextScreenTitle">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textColor">@color/primary_ink</item>
    </style>

    <style name="RecipeTextSectionTitle">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_section_title</item>
        <item name="android:textColor">@color/primary_ink</item>
    </style>

    <style name="RecipeTextRecipeTitleList">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_recipe_title_list</item>
        <item name="android:textColor">@color/primary_ink</item>
    </style>

    <style name="RecipeTextBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/primary_ink</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="RecipeTextSubtitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/secondary_ink</item>
    </style>

    <style name="RecipeTextMetadata">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_metadata</item>
        <item name="android:textColor">@color/secondary_ink</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="RecipeTextOverline">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_metadata</item>
        <item name="android:textColor">@color/secondary_ink</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="RecipeTextFieldLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/primary_ink</item>
    </style>

    <!-- ===================== Inputs ===================== -->

    <style name="RecipeEditText">
        <item name="android:background">@drawable/bg_editorial_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">@dimen/text_input</item>
        <item name="android:textColorHint">@color/secondary_ink</item>
        <item name="android:textColor">@color/primary_ink</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- ===================== Buttons ===================== -->

    <style name="RecipeButtonPrimary">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="RecipeButtonSecondary">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/primary_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="RecipeButtonDanger">
        <item name="android:background">@drawable/bg_danger_button</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="RecipeButtonText">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>